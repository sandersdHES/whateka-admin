# Copy this file to `.env` (gitignored) and fill in your own values.
# Required by src/lib/supabase.ts at build/runtime.

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-publishable-anon-key>

# Optional: Sentry frontend DSN. Leave empty to disable error reporting.
VITE_SENTRY_DSN=
